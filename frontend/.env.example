# live: реальные запросы в Go API; demo: автономная интерактивная документация
VITE_APP_MODE=live

# Для корня домена используйте /. Для GitHub Pages проекта — /<repository-name>/
VITE_BASE_PATH=/

# Используется только dev-сервером Vite в live-режиме
VITE_API_PROXY_TARGET=http://127.0.0.1:9090

# Только для локального Vite proxy. Это server-side env без префикса VITE_,
# поэтому Vite не экспортирует credential в browser bundle. Предпочтителен _FILE.
BALANCER_ADMIN_TOKEN_FILE=/absolute/path/to/local/admin-token
# BALANCER_ADMIN_TOKEN=replace-with-a-local-development-token

# Контейнерный nginx: optional mTLS к management listener
BALANCER_MANAGEMENT_TLS_ENABLED=false
BALANCER_MANAGEMENT_TLS_CA_FILE=/var/run/secrets/balancer-management/ca.crt
BALANCER_MANAGEMENT_TLS_CERT_FILE=/var/run/secrets/balancer-management/tls.crt
BALANCER_MANAGEMENT_TLS_KEY_FILE=/var/run/secrets/balancer-management/tls.key
BALANCER_MANAGEMENT_TLS_SERVER_NAME=balancer
