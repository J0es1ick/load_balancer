{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Available backends",
      "id": 1,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(load_balancer_backend_available)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red" }, { "color": "green", "value": 1 }]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Inflight requests",
      "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "load_balancer_inflight_requests", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Rate storage healthy",
      "id": 3,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "min(load_balancer_rate_limit_storage_healthy)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "degraded", "color": "red" },
                "1": { "text": "healthy", "color": "green" }
              }
            }
          ],
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "type": "stat",
      "title": "Public 5xx / second",
      "id": 4,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(load_balancer_http_requests_total{listener=\"public\",code=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Public request rate by status",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum by (code) (rate(load_balancer_http_requests_total{listener=\"public\"}[1m]))",
          "legendFormat": "HTTP {{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Public latency quantiles",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(load_balancer_http_request_duration_seconds_bucket{listener=\"public\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(load_balancer_http_request_duration_seconds_bucket{listener=\"public\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(load_balancer_http_request_duration_seconds_bucket{listener=\"public\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Upstream attempts",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "sum by (backend, outcome, retry) (rate(load_balancer_upstream_attempts_total[1m]))",
          "legendFormat": "{{backend}} / {{outcome}} / retry={{retry}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Protection events",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "sum by (kind, backend) (rate(load_balancer_protection_events_total[1m]))",
          "legendFormat": "{{kind}} {{backend}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["go", "load-balancer"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "title": "Go load balancer",
  "uid": "go-load-balancer",
  "version": 1
}
